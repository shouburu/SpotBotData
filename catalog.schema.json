{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpotBot normalized standard catalog",
  "description": "One editable launch source. build_catalog.py additionally enforces current identities, source provenance, actual editorial evidence, storage bounds and 27 starter references.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "authoringPolicy": {
          "type": "string",
          "minLength": 1
        },
        "aliasOmissions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "duplicateCandidateReviews": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "authoringPolicy",
        "aliasOmissions",
        "duplicateCandidateReviews"
      ],
      "additionalProperties": false
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/exercise"
      }
    },
    "redirects": {
      "type": "object",
      "maxProperties": 0,
      "description": "Empty transport field for the clean launch catalog; no retired identities are retained."
    },
    "sourceDecisions": {
      "type": "array",
      "minItems": 873,
      "maxItems": 873,
      "items": {
        "$ref": "#/definitions/sourceDecision"
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/review"
      }
    },
    "starterWorkouts": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "$ref": "#/definitions/starter"
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "revision",
    "sources",
    "provenance",
    "exercises",
    "redirects",
    "sourceDecisions",
    "reviews",
    "starterWorkouts"
  ],
  "additionalProperties": false,
  "definitions": {
    "equipmentLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "$comment": "Validated against the SpotBot shared equipment vocabulary by the required runtime bridge."
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "prescription": {
      "type": "object",
      "properties": {
        "sets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "restSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 900
        },
        "repRange": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(?:\\s*[-–]\\s*[1-9][0-9]*)?$",
          "maxLength": 40
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        "distanceMeters": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "sets",
        "restSeconds"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "activities": {
          "type": "array",
          "items": {
            "enum": [
              "strength",
              "cardio",
              "calisthenics",
              "yoga",
              "mobility",
              "stretching",
              "pilates",
              "balance",
              "conditioning"
            ]
          },
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true
        },
        "goals": {
          "type": "array",
          "items": {
            "enum": [
              "strength",
              "hypertrophy",
              "endurance",
              "athleticism",
              "weight-loss",
              "mobility",
              "general"
            ]
          },
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true
        },
        "primaryMuscles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "secondaryMuscles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/equipmentLabel"
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "difficulty": {
          "$ref": "#/definitions/difficulty"
        },
        "measurementType": {
          "enum": [
            "reps",
            "duration",
            "distance",
            "time_distance"
          ]
        },
        "loadBehavior": {
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "perSide": {
          "type": "boolean"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "maxItems": 30,
          "uniqueItems": true
        },
        "defaultPrescription": {
          "$ref": "#/definitions/prescription"
        },
        "source": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            }
          },
          "required": [
            "name",
            "revision",
            "license"
          ],
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "reviewedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "required": [
            "method",
            "reviewedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "activities",
        "goals",
        "primaryMuscles",
        "secondaryMuscles",
        "equipment",
        "difficulty",
        "measurementType",
        "loadBehavior",
        "aliases",
        "defaultPrescription",
        "source",
        "review"
      ],
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,35}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "muscle_group": {
          "enum": [
            "Chest",
            "Back",
            "Shoulders",
            "Arms",
            "Legs",
            "Core",
            "Full Body"
          ]
        },
        "movementType": {
          "enum": [
            "compound",
            "isolation",
            "other"
          ]
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          }
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        }
      },
      "required": [
        "id",
        "name",
        "muscle_group",
        "movementType",
        "instructions",
        "metadata"
      ],
      "additionalProperties": false
    },
    "starter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,35}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "activity": {
          "enum": [
            "strength",
            "cardio",
            "calisthenics",
            "yoga",
            "mobility",
            "stretching",
            "pilates",
            "balance",
            "conditioning"
          ]
        },
        "difficulty": {
          "$ref": "#/definitions/difficulty"
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "exerciseId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,35}$"
              },
              "sets": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "restSeconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 900
              },
              "repRange": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:\\s*[-–]\\s*[0-9]+(?:\\.[0-9]+)?)?$",
                "maxLength": 40
              },
              "durationSeconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 86400
              },
              "distanceMeters": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000
              },
              "perSide": {
                "type": "boolean"
              }
            },
            "required": [
              "exerciseId",
              "sets",
              "restSeconds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "activity",
        "difficulty",
        "exercises"
      ],
      "additionalProperties": false
    },
    "sourceDecision": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": [
            "imported",
            "mapped",
            "excluded"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "canonicalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,35}$"
        },
        "relatedAdaptationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,35}$"
        },
        "sourceRecordSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "normalization": {
          "type": "object"
        },
        "review": {
          "type": "object",
          "required": [
            "method",
            "reviewedAt",
            "instructionCount",
            "decision"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "reviewedAt": {
              "type": "string",
              "minLength": 1
            },
            "instructionCount": {
              "type": "integer",
              "minimum": 0
            },
            "decision": {
              "type": "string",
              "minLength": 1
            },
            "modelRequirement": {
              "type": "string"
            },
            "adaptationRelationship": {
              "type": "string"
            },
            "phaseEvidence": {
              "type": "string"
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "sourceId",
        "sourceName",
        "status",
        "reason",
        "sourceRecordSha256"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "retain",
            "repair",
            "add"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1
        },
        "instructionReview": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "minProperties": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "decision",
        "method",
        "reviewedAt",
        "instructionReview",
        "evidence",
        "changes"
      ],
      "additionalProperties": false
    }
  }
}
